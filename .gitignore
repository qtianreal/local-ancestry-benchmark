# Environments and third-party binaries (regenerable; see README)
.venv/
tools/
__pycache__/
*.pyc

# Downloaded data (public; exact source recorded in the manuscript)
data/
*.vcf.gz
*.vcf.gz.tbi

# Trained model checkpoints and cached test tensors -- regenerable from the
# code with the recorded seeds, and far too large to version.
results/cache/

# Oversized EPS renderings; the TIFFs in figures/submission/ are the
# submission artefacts and are kept.
figures/submission/*.eps

# LaTeX build products
*.aux
*.bbl
*.blg
*.out
*.synctex.gz
*.fdb_latexmk
*.fls
paper/*.log
texput.log

# Run logs
*.log
!BUILD.md

# macOS metadata
.DS_Store

# Session-specific orchestration wrappers contained absolute paths and were
# removed; the run order is documented in README.md instead.

# Compiled PDFs -- build from source (see paper/BUILD.md). The version of
# record is the journal PDF; copies here would go stale after revisions.
paper/manuscript.pdf
paper/supplementary.pdf


# Publisher PDF of a reference article, kept locally for formatting only.
# Copyrighted; must not be redistributed.
paper/Genome Res.-*.pdf

# Submission TIFFs -- 21 MB of derived artefacts, regenerated by
# make_submission_figures.py. Versioning them let a stale numbering survive
# a figure reorder once already.
figures/submission/

# Manuscript prose, bibliography and submission material live in the Overleaf
# project, not here. This repository carries the analysis, the derived results
# and make_numbers.py -- which is what the Data access statement promises and
# what makes the reported numbers checkable.
paper/*.tex
!paper/numbers.tex
paper/*.bib
paper/*.bst
paper/BUILD.md
paper/unwrap.py
paper/cover_letter.md
paper/plain_text.py
paper/abstract_plain.txt
paper/cover_letter_plain.txt
paper/crossref_*.json
